# ─────────────────────────────────────────────────────────────
# PROXIMA environment variables — TEMPLATE (safe to commit, no real secrets)
#
# How to use:
#   1. Copy this file:   cp .env.example .env.local      (Windows: Copy-Item .env.example .env.local)
#   2. Fill in the values in .env.local — that file is NEVER committed.
#   3. Check your setup:  npm run env:check
#   4. On Vercel, add the same keys in Project → Settings → Environment Variables.
#
# Click-by-click guide for every value: docs/ACCOUNTS.md
# Variables starting with NEXT_PUBLIC_ are visible in the browser. Never put secrets in them.
# ─────────────────────────────────────────────────────────────

# Public URL of the site (no trailing slash).
# Local: http://localhost:3000
# On Vercel you can leave it OUT: Vercel tells the site its address automatically.
# Set it only when you use your own domain, e.g. https://proxima.com (docs/DEPLOY.md, Step 5).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database: Neon (docs/ACCOUNTS.md → A) ──
# Pooled string (contains "-pooler") — used by the website.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# Direct string (no "-pooler") — used by migrations (npm run db:deploy / db:migrate).
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ── Login: Auth.js (docs/ACCOUNTS.md → B) ──
# Random 32+ character string. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
# Google Cloud → Google Auth Platform → Clients → Proxima Web
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── Optional: email magic-link login (docs/ACCOUNTS.md → D) ──
# Leave BOTH empty to keep email login switched off (Google only).
# AUTH_RESEND_KEY="re_xxxxxxxxx"
# AUTH_EMAIL_FROM="PROXIMA <login@yourdomain.com>"

# ── Optional: extra hostnames allowed to open the DEV server (comma separated) ──
# Your phone on the same Wi-Fi (192.168.x.x / 10.x.x.x) already works.
# ALLOWED_DEV_ORIGINS=

# ── AI engine ──
# Which AI to use. A NAME, not a web address:
#   "nvidia" = NVIDIA NIM (default)   "render" = the PROXIMA Core API on Render
#   "mock"   = fake offline AI for development
# If NVIDIA fails before it has written anything, PROXIMA falls back to Render
# automatically, so you normally never see an error.
AI_PROVIDER="nvidia"

# NVIDIA NIM — get a key at https://build.nvidia.com (server only, never public).
# Paste your own key here. This file is committed, so leave it EMPTY in Git.
NVIDIA_API_KEY=""
# Which model to call. Default shown.
NVIDIA_MODEL="nvidia/nemotron-3-ultra-550b-a55b"
# Longest answer, in tokens. Default 4096.
NVIDIA_MAX_TOKENS="4096"
# Let the model think privately before answering (its reasoning is hidden).
NVIDIA_ENABLE_THINKING="true"
# Give up on NVIDIA and switch to Render after this many ms. Default 45000.
NVIDIA_TIMEOUT_MS="45000"

# Render fallback — the old PROXIMA Core API. Called ONLY from the server.
AI_API_URL="https://sujancoreapi.onrender.com/chat"
# Total time to wait for an answer before giving up (ms). Render cold starts can take ~60 s.
AI_TIMEOUT_MS="90000"

# ── Optional: other websites allowed to call the API (comma separated, full origins) ──
# Your own site is always allowed. Leave empty unless you know you need it.
# ALLOWED_ORIGINS="https://my-other-site.com"
