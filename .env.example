# ─────────────────────────────────────────────────────────────
# PROXIMA environment variables — TEMPLATE (safe to commit)
#
# How to use:
#   1. Copy this file:   cp .env.example .env.local
#   2. Fill in the values in .env.local (that file is NEVER committed).
#   3. On Vercel, add the same keys in Project → Settings → Environment Variables.
#
# Variables starting with NEXT_PUBLIC_ are visible in the browser.
# Everything else stays on the server. Never put secrets in NEXT_PUBLIC_ vars.
# ─────────────────────────────────────────────────────────────

# Public URL of the site (no trailing slash).
# Local: http://localhost:3000   Production: https://your-project.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: extra hostnames allowed to open the DEV server (comma separated).
# Your phone on the same Wi-Fi (192.168.x.x / 10.x.x.x) already works.
# ALLOWED_DEV_ORIGINS=

# ── Added in Phase 2 (database + login) ──
# DATABASE_URL=
# DIRECT_URL=
# AUTH_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# ── Added in Phase 3 (AI API) ──
# AI_API_URL=https://sujancoreapi.onrender.com/chat
