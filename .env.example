# ─────────────────────────────────────────────────────────────
# PROXIMA environment variables — TEMPLATE (safe to commit, no real secrets)
#
# How to use:
#   1. Copy this file:   cp .env.example .env.local      (Windows: Copy-Item .env.example .env.local)
#   2. Fill in the values in .env.local — that file is NEVER committed.
#   3. Check your setup:  npm run env:check
#   4. On Vercel, add the same keys in Project → Settings → Environment Variables.
#
# Click-by-click guide for every value: docs/ACCOUNTS.md
# Variables starting with NEXT_PUBLIC_ are visible in the browser. Never put secrets in them.
# ─────────────────────────────────────────────────────────────

# Public URL of the site (no trailing slash).
# Local: http://localhost:3000
# On Vercel you can leave it OUT: Vercel tells the site its address automatically.
# Set it only when you use your own domain, e.g. https://proxima.com (docs/DEPLOY.md, Step 5).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database: Neon (docs/ACCOUNTS.md → A) ──
# Pooled string (contains "-pooler") — used by the website.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# Direct string (no "-pooler") — used by migrations (npm run db:deploy / db:migrate).
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ── Login: Auth.js (docs/ACCOUNTS.md → B) ──
# Random 32+ character string. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
# Google Cloud → Google Auth Platform → Clients → Proxima Web
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── Optional: email magic-link login (docs/ACCOUNTS.md → D) ──
# Leave BOTH empty to keep email login switched off (Google only).
# AUTH_RESEND_KEY="re_xxxxxxxxx"
# AUTH_EMAIL_FROM="PROXIMA <login@yourdomain.com>"

# ── Optional: extra hostnames allowed to open the DEV server (comma separated) ──
# Your phone on the same Wi-Fi (192.168.x.x / 10.x.x.x) already works.
# ALLOWED_DEV_ORIGINS=

# ── AI engine ──
# Which AI to use. A NAME, not a web address:
#   "nvidia" = NVIDIA NIM (default)   "render" = the PROXIMA Core API on Render
#   "mock"   = fake offline AI for development
# If NVIDIA fails before it has written anything, PROXIMA falls back to Render
# automatically, so you normally never see an error.
AI_PROVIDER="nvidia"

# NVIDIA NIM — get a key at https://build.nvidia.com (server only, never public).
# Paste your own key here. This file is committed, so leave it EMPTY in Git.
NVIDIA_API_KEY=""
# Only if the picture model sits on a different NVIDIA account: its own key.
# Leave empty to use NVIDIA_API_KEY for both. Server only, never public.
# NVIDIA_VISION_API_KEY=""
# Normal answers (text, code, analysis). Default shown.
NVIDIA_MODEL="nvidia/nemotron-3-ultra-550b-a55b"
# Attached pictures are read by a second NVIDIA model, then the normal model
# answers. Runs with thinking off. Default shown.
NVIDIA_VISION_MODEL="nvidia/nemotron-3-nano-omni-30b-a3b-reasoning"
# For Coding mode: add your OpenRouter key (server only). Uses the free
# Nemotron 3 Ultra model with up to 65536 output tokens per call.
# OPENROUTER_API_KEY=""
# Longest NVIDIA answer, in tokens (includes private reasoning). Default 16384.
NVIDIA_MAX_TOKENS="16384"
# Let the model think privately before answering (its reasoning is hidden).
NVIDIA_ENABLE_THINKING="true"
# Switch to Render if NVIDIA produces no first token within this many ms. Default 45000.
# Once the answer starts, it may keep streaming until its overall deadline.
NVIDIA_TIMEOUT_MS="45000"
# Optional: allow OpenRouter more time before switching providers.
OPENROUTER_TIMEOUT_MS="150000"
# Coding no-output timeout; the overall host/request deadline still applies.
AI_CODING_IDLE_TIMEOUT_MS="180000"

# Render fallback — the old PROXIMA Core API. Called ONLY from the server.
AI_API_URL="https://sujancoreapi.onrender.com/chat"
# Total time to wait for an answer before giving up (ms). Render cold starts can take ~60 s;
# a long Analyze answer needs room too. Coding uses a separate deadline.
AI_TIMEOUT_MS="110000"
# Coding total deadline in ms (default 290000, max 295000). Your hosting plan
# can enforce a shorter limit. Long streams may still need to be resumed.
# AI_CODING_TIMEOUT_MS="290000"

# ── Picture reader alternatives ──
# The two-model default is set above: Ultra answers, Omni reads pictures.
# Uncomment one line to use a different reader, or turn it off:
# Older / smaller Llama readers:
# NVIDIA_VISION_MODEL="meta/llama-3.2-90b-vision-instruct"
# NVIDIA_VISION_MODEL="meta/llama-3.2-11b-vision-instruct"
# Turn the reader off (the AI will ask you to describe the picture instead):
# NVIDIA_VISION_MODEL="off"
# Only needed when you put a vision model in NVIDIA_MODEL whose name doesn't say so:
# NVIDIA_VISION="true"

# ── Image studio: upload, AI create, AI edit (docs/IMAGES.md) ──
# Which engine to use:
#   "auto" (default) = NVIDIA FLUX → OpenAI if keyed, or offline if no keys
#   "nvidia" | "openai" | "mock"
IMAGE_PROVIDER="auto"
# NVIDIA FLUX.1 dev creates pictures. Its key is IMAGE_GENERATION.
# NVIDIA FLUX.1 Kontext edits them. Its key is IMAGE_EDITING. The two models
# may live on different NVIDIA accounts, so the keys are separate. Leave
# IMAGE_EDITING empty to fall back to IMAGE_GENERATION (one account).
# NVIDIA hosted Kontext currently documents example images only; for editing
# your own images see docs/IMAGES.md for supported alternatives.
# IMAGE_GENERATION=""
# IMAGE_EDITING=""
# Optional model ids (defaults shown). Any FLUX id from build.nvidia.com works.
# IMAGE_GENERATION_MODEL="black-forest-labs/flux.1-dev"
# IMAGE_EDITING_MODEL="black-forest-labs/flux.1-kontext-dev"
# IMAGE_EDITING_URL="https://your-nim.example/v1/infer" # optional self-hosted Kontext
# OpenAI Images is the other create + edit engine (server only).
# The same key also unlocks OpenAI's most natural spoken voice.
# OPENAI_API_KEY=""
# OPENAI_IMAGE_MODEL="gpt-image-1"
# How long to wait for a picture before giving up (ms). Default 90000.
# IMAGE_TIMEOUT_MS="90000"
# A temporary signed link to a picture (10 minutes, then it dies), for engines
# that fetch the source by URL. Built from NEXT_PUBLIC_SITE_URL, or from the
# request's own address when that is unset. Set a separate secret here if you
# ever rotate AUTH_SECRET without wanting old links to survive.
# IMAGE_SIGNING_SECRET=""

# ── Voice: natural spoken replies (docs/VOICE.md) ──
# The voice menu's "Natural" quality asks our server for neural audio. With no
# key it uses Microsoft's free Edge voices (the same natural voices Edge reads
# pages with). "Device" always means the browser's built-in voice, and any
# failure below falls back to it automatically.
#
#   "auto" (default) = OpenAI (if key) → Pollinations (if key) → Edge (free)
#   "openai" | "pollinations" | "edge" = force one engine
#   "off" = never use a natural voice (browser voice only)
SPEECH_PROVIDER="auto"
# Change which voice each choice uses. Defaults shown.
# SPEECH_EDGE_VOICE_GIRL="en-US-AvaNeural"
# SPEECH_EDGE_VOICE_BOY="en-US-AndrewNeural"
# SPEECH_OPENAI_VOICE_GIRL="marin"
# SPEECH_OPENAI_VOICE_BOY="cedar"
# SPEECH_POLLINATIONS_VOICE_GIRL="nova"
# SPEECH_POLLINATIONS_VOICE_BOY="onyx"
# OpenAI's speech model (needs OPENAI_API_KEY above).
# SPEECH_OPENAI_MODEL="gpt-4o-mini-tts"
# Pollinations' speech model (needs a Pollinations key; images no longer use it).
# POLLINATIONS_API_KEY="sk_…"
# SPEECH_POLLINATIONS_MODEL="tts-1"
# Override the base address only if you proxy the service yourself.
# SPEECH_POLLINATIONS_URL="https://gen.pollinations.ai"
# Server side: give up on a voice provider after this long (ms). The browser
# gives up on one piece after 10 s and continues with the device voice.
# SPEECH_TIMEOUT_MS="25000"
# Stop using Microsoft's unofficial Edge endpoint entirely (auto then uses
# only keyed engines; with no keys, natural voice is unavailable).
# SPEECH_EDGE="off"

# ── Optional: other websites allowed to call the API (comma separated, full origins) ──
# Your own site is always allowed. Leave empty unless you know you need it.
# ALLOWED_ORIGINS="https://my-other-site.com"
